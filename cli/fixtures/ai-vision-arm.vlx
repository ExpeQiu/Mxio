{
  "format": "velxio-project",
  "version": 1,
  "exportedAt": "2026-08-18T12:22:16.423Z",
  "name": "ESP32-CAM: AI 视觉机械臂（人脸跟随）",
  "boards": [
    {
      "id": "esp32-cam",
      "boardKind": "esp32-cam",
      "x": 240,
      "y": 80,
      "activeFileGroupId": "group-esp32-cam",
      "libraries": [
        "ESP32Servo"
      ]
