# Use credentials for Doubao Speech realtime dialogue, not an Ark text-model key.
# New speech console credentials:
DOUBAO_API_KEY=
# Alternatively, legacy speech console credentials:
DOUBAO_APP_ID=
DOUBAO_ACCESS_TOKEN=
# Official O2.0 model version; SC2.0 is 2.2.0.0 and needs a compatible speaker.
DOUBAO_VOICE_MODEL=1.2.1.1
DOUBAO_SPEAKER=zh_female_vv_jupiter_bigtts
