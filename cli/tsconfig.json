{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@pro/*": ["../frontend/src/__pro_stub__/*"],
      "@velxio/*": ["../frontend/src/*"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
